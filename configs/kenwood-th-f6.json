{
  "$schema": "https://springfield-ham-radio.com/schemas/radio-config-v1.json",
  "id": {
    "model": "kenwood-th-f6",
    "name": "Kenwood TH-F6",
    "manufacturer": "Kenwood"
  },
  "version": "1.13.0",
  "minApiVersion": "18.0.1",
  "description": "TH-F6 live CAT programming. Memory map is a logical 32-byte channel image; serial I/O uses Kenwood MR/MW/MNA commands (see docs/th-f6-live.md).",
  "readMessage": {
    "title": "Set Menu 9 to PC",
    "body": "This radio answers the computer only when Menu 9 (SP/MIC JACK) is PC. The default is SP/MIC.\n\nPress [MNU], choose menu 9, press [MNU] again, select PC, then press [MNU] to store. Turn the radio off, connect the programming cable to the SP/MIC jack (the two-plug Kenwood cable), and turn the radio on.\n\nThe PC port is 9600 baud, 8 data bits, no parity, 1 stop bit. Leave HamBench at 9600 unless a read fails. Menu 28 (PACKET) is the TNC speed, not this baud.",
    "severity": "info"
  },
  "writeMessage": {
    "title": "Set Menu 9 to PC",
    "body": "This radio answers the computer only when Menu 9 (SP/MIC JACK) is PC. The default is SP/MIC.\n\nPress [MNU], choose menu 9, press [MNU] again, select PC, then press [MNU] to store. Turn the radio off, connect the programming cable to the SP/MIC jack (the two-plug Kenwood cable), and turn the radio on.\n\nThe PC port is 9600 baud, 8 data bits, no parity, 1 stop bit. Leave HamBench at 9600 unless a read fails. Menu 28 (PACKET) is the TNC speed, not this baud.",
    "severity": "info"
  },
  "capabilities": {
    "memoryRead": true,
    "memoryWrite": true,
    "channelProgramming": true,
    "settingsProgramming": true,
    "liveControl": true
  },
  "bands": ["2m", "1.25m", "70cm"],
  "cat": {
    "protocol": "kenwood",
    "wakeCr": true,
    "vfoCount": 1,
    "frequencyCommands": ["FQ", "FO"],
    "frequencyWidth": 11,
    "modes": ["FM", "WFM", "AM", "LSB", "USB", "CW"],
    "powers": ["H", "L", "EL"],
    "modeCommand": "MD"
  },
  "metadata": {
    "author": "Springfield Ham Radio",
    "license": "MIT",
    "homepage": "https://springfield-ham-radio.com",
    "repository": "https://github.com/springfield-ham-radio/radio-module-kenwood"
  },
  "settingsSchema": {
    "model": "kenwood-th-f6",
    "settingsSchema": {
      "$ref": "../src/shared/schemas/settings-schema.json"
    },
    "channelSchema": {
      "$ref": "../src/shared/schemas/channel-schema.json"
    }
  },
  "memoryMap": {
    "$ref": "../src/shared/memory-maps/th-f6-settings.json"
  },
  "codec": {
    "type": "memoryMap"
  },
  "serialConfig": {
    "baudRate": 9600,
    "baudRates": [4800, 9600, 19200, 38400, 57600, 115200],
    "dataBits": 8,
    "stopBits": 1,
    "parity": "none",
    "rtscts": false,
    "rts": false,
    "dtr": true
  },
  "memoryConfig": {
    "chunkSize": 32,
    "addressSize": 2,
    "addressEndianness": "big",
    "segments": {
      "channels": {
        "startAddress": 0,
        "endAddress": 12799
      },
      "settings": {
        "startAddress": 12800,
        "endAddress": 12927
      }
    }
  },
  "readMemory": [
    {
      "description": "Wake CAT",
      "send": ["0x0D"],
      "delay": 150
    },
    {
      "description": "Identify radio",
      "send": ["I", "D", "0x0D"],
      "expect": { "until": "0x0D" },
      "timeout": 3000
    },
    {
      "description": "Disable auto-info (AI 0)",
      "send": ["A", "I", " ", "0", "0x0D"],
      "expect": { "until": "0x0D" },
      "timeout": 3000
    },
    {
      "description": "Read memories via live CAT",
      "catRead": {
        "segment": "channels",
        "count": 400,
        "recordSize": 32,
        "pack": "kenwood-th-f6",
        "timeout": 2000,
        "interCommandDelayMs": 20
      }
    }
  ],
  "writeMemory": [
    {
      "description": "Wake CAT",
      "send": ["0x0D"],
      "delay": 150
    },
    {
      "description": "Identify radio",
      "send": ["I", "D", "0x0D"],
      "expect": { "until": "0x0D" },
      "timeout": 3000
    },
    {
      "description": "Disable auto-info (AI 0)",
      "send": ["A", "I", " ", "0", "0x0D"],
      "expect": { "until": "0x0D" },
      "timeout": 3000
    },
    {
      "description": "Write memories via live CAT",
      "catWrite": {
        "segment": "channels",
        "count": 400,
        "recordSize": 32,
        "pack": "kenwood-th-f6",
        "timeout": 2000,
        "interCommandDelayMs": 20
      }
    }
  ]
}
