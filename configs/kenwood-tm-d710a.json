{
  "$schema": "https://springfield-ham-radio.com/schemas/radio-config-v1.json",
  "id": {
    "model": "kenwood-tm-d710a",
    "name": "Kenwood TM-D710A",
    "manufacturer": "Kenwood"
  },
  "version": "1.14.0",
  "minApiVersion": "18.3.0",
  "description": "TM-D710A clone-mode programming (256-byte R/W blocks after 0M PROGRAM; skips radio block 0x7F)",
  "capabilities": {
    "memoryRead": true,
    "memoryWrite": true,
    "channelProgramming": true,
    "settingsProgramming": true,
    "liveControl": true,
    "aprsReceive": true
  },
  "bands": ["2m", "70cm"],
  "cat": {
    "protocol": "kenwood",
    "vfoCount": 2,
    "frequencyCommands": ["FO"],
    "frequencyWidth": 10,
    "vfoChannel": true,
    "modes": ["FM", "NFM", "AM"],
    "powers": ["High", "Medium", "Low"],
    "bandControl": true,
    "powerBandIndex": true
  },
  "metadata": {
    "author": "Springfield Ham Radio",
    "license": "MIT",
    "homepage": "https://springfield-ham-radio.com",
    "repository": "https://github.com/springfield-ham-radio/radio-module-kenwood"
  },
  "settingsSchema": {
    "model": "kenwood-tm-d710a",
    "settingsSchema": {
      "$ref": "../src/shared/schemas/settings-schema.json"
    },
    "channelSchema": {
      "$ref": "../src/shared/schemas/channel-schema.json"
    }
  },
  "memoryMap": {
    "$ref": "../src/shared/memory-maps/tm-d710a-settings.json"
  },
  "codec": {
    "type": "memoryMap"
  },
  "serialConfig": {
    "baudRate": 9600,
    "baudRates": [9600, 19200, 38400, 57600],
    "dataBits": 8,
    "stopBits": 1,
    "parity": "none",
    "rtscts": false
  },
  "aprs": {
    "mode": "monitor",
    "baudRate": 9600,
    "baudRates": [9600, 19200, 38400, 57600],
    "help": "Control-head COM jack, not the body PC memory or CAT port. Match menu 528 to this baud. HamBench does not change radio menus.",
    "monitorNote": "Passive monitor only. Menu 604 OUTPUT ON copies heard APRS while the radio is showing APRS. COM baud is menu 528. HamBench does not change that menu.",
    "host": {
      "interrupt": [3, 3, 3],
      "prompt": "cmd:",
      "errorReply": "?EH",
      "waitMs": 5000,
      "enter": [
        { "text": "KISS ON\r", "label": "KISS ON" },
        { "text": "RESTART\r", "label": "RESTART" }
      ],
      "flows": ["software", "none", "hardware"],
      "defaultFlow": "software",
      "flowHelp": "Software is the default and keeps RTS and DTR low, as does Off. Hardware (RTS/CTS) is required when the TNC already shows XFLOW OFF. The driver handles RTS. It does not force RTS low and it does not send XFLOW.",
      "setup": [
        "Connect writes nothing. Request writes three Ctrl+C only when this connection has no cmd:. Enter host KISS writes KISS ON only after that cmd:, then RESTART only after another cmd:. An ?EH reply stops the sequence before RESTART. cmd: is not proof of PACKET mode.",
        "Head COM is not the CAT or memory port. Menu 528 is the COM baud. The tested host path is menu 529 PACKET data band B on 144.390. Menu 604 OUTPUT is the passive monitor only. HamBench does not change those menus and does not send XFLOW."
      ],
      "recovery": [
        "The A/E KISS sentence says power OFF then ON causes the TNC to enter (or exit) KISS when the parameter is ON. The G sentence uses RESTART for that wording. Neither says the result alternates, and different editions do not prove that repeating a power cycle alternates. One cycle with the COM port still open and hardware RTS ready can show the startup banner. That banner is not a guaranteed reset or exit, and cmd: in it is not proof of PACKET mode. No binary KISS exit is manual-verified. HamBench does not send KISS OFF, XFLOW, Ctrl+C, or a carriage return to probe an unknown mode."
      ]
    }
  },
  "memoryConfig": {
    "chunkSize": 256,
    "addressSize": 2,
    "addressEndianness": "big",
    "segments": {
      "image_lo": {
        "startAddress": 0,
        "endAddress": 32511
      },
      "image_hi": {
        "startAddress": 32768,
        "endAddress": 39935
      },
      "block_fe": {
        "startAddress": 65264,
        "endAddress": 65279
      },
      "block_ff": {
        "startAddress": 65280,
        "endAddress": 65423
      }
    }
  },
  "readMemory": [
    {
      "description": "Identify radio (ID TM-D710)",
      "send": ["I", "D", "0x0D"],
      "expect": ["I", "D", " ", "T", "M", "-", "D", "7", "1", "0", "0x0D"]
    },
    {
      "description": "Enter programming mode",
      "send": ["0", "M", " ", "P", "R", "O", "G", "R", "A", "M", "0x0D"],
      "expect": ["0", "M", "0x0D"]
    },
    {
      "description": "Read clone blocks",
      "read": {
        "segments": ["image_lo", "image_hi", "block_fe", "block_ff"],
        "send": ["R", "$address", "$chunkSize"],
        "expect": ["W", "$address", "$chunkSize", "$data"],
        "timeout": 2000,
        "delay": 100,
        "ack": {
          "send": ["0x06"],
          "expect": "0x06"
        }
      }
    },
    {
      "description": "Leave programming mode",
      "send": ["E"]
    }
  ],
  "writeMemory": [
    {
      "description": "Identify radio (ID TM-D710)",
      "send": ["I", "D", "0x0D"],
      "expect": ["I", "D", " ", "T", "M", "-", "D", "7", "1", "0", "0x0D"]
    },
    {
      "description": "Enter programming mode",
      "send": ["0", "M", " ", "P", "R", "O", "G", "R", "A", "M", "0x0D"],
      "expect": ["0", "M", "0x0D"]
    },
    {
      "description": "Write clone blocks",
      "write": {
        "segments": ["image_lo", "image_hi", "block_fe", "block_ff"],
        "send": ["W", "$address", "$chunkSize", "$data"],
        "expect": "0x06",
        "timeout": 2000,
        "delay": 100
      }
    },
    {
      "description": "Leave programming mode",
      "send": ["E"]
    }
  ],
  "onError": {
    "readMemory": [{ "send": ["E"] }],
    "writeMemory": [{ "send": ["E"] }]
  }
}
