{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://springfield-ham-radio.com/schemas/capture-v1.json",
  "title": "Menu capture wizard hints",
  "description": "Optional module metadata for HamBench menu-capture: bytes to ignore when diffing clone images.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ignore"],
  "properties": {
    "ignore": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["address", "length", "reason"],
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^0x[0-9A-Fa-f]+$"
          },
          "length": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}