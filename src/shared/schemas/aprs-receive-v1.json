{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://springfield-ham-radio.com/schemas/aprs-receive-v1.json",
  "title": "APRS receive block",
  "description": "Shape HamBench reads from an installed module when capabilities.aprsReceive is true. This file is the module contract check. radio-config-v1 does not define aprs; the protocol schema leaves the key through as an additional property. flowControl is the serial mode HamBench applies for host/KISS. flows and defaultFlow remain the older choice list.",
  "oneOf": [
    { "$ref": "#/definitions/monitorMode" },
    { "$ref": "#/definitions/kissMode" }
  ],
  "definitions": {
    "flowControlEnum": {
      "enum": ["hardware", "software", "none"]
    },
    "kissFlowControlEnum": {
      "description": "Manual KISS entry allows only none or hardware. HamBench PR 241 rejects software on kiss-only hosts.",
      "enum": ["hardware", "none"]
    },
    "setupRecoveryStrings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 700 }
    },
    "monitorHost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interrupt", "prompt", "errorReply", "waitMs", "enter", "flows", "defaultFlow", "flowHelp", "setup", "recovery"],
      "properties": {
        "interrupt": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 16, "pattern": "^[\\u0020-\\u007e]+$" },
        "errorReply": { "type": "string", "minLength": 1, "maxLength": 16, "pattern": "^[\\u0020-\\u007e]+$" },
        "waitMs": { "type": "integer", "minimum": 1000, "maximum": 60000 },
        "listenMs": {
          "description": "How long Connect listens, in milliseconds, before treating the TNC as silent. HamBench reads aprs.host.listenMs, default 3000, range 500 to 15000. Command text in this window starts the enter steps. Silence sends the interrupt once, then kissExit once if this block declares it.",
          "type": "integer",
          "minimum": 500,
          "maximum": 15000
        },
        "kissExit": {
          "description": "Optional bytes sent once when Connect is still silent after the interrupt. The TM-D710A value is the KISS specification return-from-KISS frame 0xC0 0xFF 0xC0. The Kenwood manuals have not verified that frame on this radio.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "promptNudge": {
          "description": "Optional bytes written at most once per detection pass, only after interrupt was written, and only when printable command text arrived after that interrupt without the prompt. Connect then waits waitMs for a fresh prompt. Not written on silence, before the interrupt, or after a KISS data frame. The TM-D710A value is a carriage return (13). A terminal session observed a fresh cmd: after a carriage return at an existing prompt. The Kenwood manuals do not document that reply. SENDPAC $0D sends a packet only in Converse.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "enter": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "label"],
            "properties": {
              "text": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[\\u0009-\\u007e]+$" },
              "label": { "type": "string", "minLength": 1, "maxLength": 24, "pattern": "^[\\u0020-\\u007e]+$" }
            }
          }
        },
        "flowControl": {
          "description": "Serial flow control HamBench applies for host/KISS on this TNC port. hardware is RTS/CTS, software is XON/XOFF, and none leaves both off. Omit when that port's flow control is not known. This key is separate from flows and defaultFlow.",
          "$ref": "#/definitions/flowControlEnum"
        },
        "flows": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/flowControlEnum" }
        },
        "defaultFlow": { "$ref": "#/definitions/flowControlEnum" },
        "flowHelp": { "type": "string", "minLength": 1, "maxLength": 700 },
        "setup": { "$ref": "#/definitions/setupRecoveryStrings" },
        "recovery": { "$ref": "#/definitions/setupRecoveryStrings" }
      }
    },
    "kissHost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "kissExit", "enter", "flowControl", "dtr", "rts", "flows", "defaultFlow", "flowHelp", "entryHint", "setup", "recovery"],
      "properties": {
        "entry": { "const": "manual" },
        "kissExit": {
          "description": "Bytes sent once on Disconnect. The TH-D74 manual documents the KISS return frame 0xC0 0xFF 0xC0.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "enter": {
          "type": "array",
          "maxItems": 0,
          "items": false
        },
        "flowControl": {
          "description": "Serial flow control HamBench applies for KISS on this port.",
          "$ref": "#/definitions/kissFlowControlEnum"
        },
        "dtr": {
          "description": "DTR line while KISS is connected. asserted matches HamBench PR 241; low deasserts.",
          "enum": ["asserted", "low"]
        },
        "rts": {
          "description": "RTS line while KISS is connected. asserted matches HamBench PR 241; low deasserts.",
          "enum": ["asserted", "low"]
        },
        "flows": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/flowControlEnum" }
        },
        "defaultFlow": { "$ref": "#/definitions/flowControlEnum" },
        "flowHelp": { "type": "string", "minLength": 1, "maxLength": 700 },
        "entryHint": { "type": "string", "minLength": 1, "maxLength": 700 },
        "setup": { "$ref": "#/definitions/setupRecoveryStrings" },
        "recovery": { "$ref": "#/definitions/setupRecoveryStrings" }
      }
    },
    "monitorMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "baudRate", "baudRates", "help", "monitorNote", "host"],
      "properties": {
        "mode": { "const": "monitor" },
        "baudRate": { "enum": [9600, 19200, 38400, 57600] },
        "baudRates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": [9600, 19200, 38400, 57600] }
        },
        "help": { "type": "string", "minLength": 1, "maxLength": 700 },
        "monitorNote": { "type": "string", "minLength": 1, "maxLength": 700 },
        "host": { "$ref": "#/definitions/monitorHost" }
      }
    },
    "kissMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "baudRate", "baudRates", "help", "monitorNote", "host"],
      "properties": {
        "mode": { "const": "kiss" },
        "baudRate": { "enum": [9600, 19200, 38400, 57600] },
        "baudRates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": [9600, 19200, 38400, 57600] }
        },
        "help": { "type": "string", "minLength": 1, "maxLength": 700 },
        "monitorNote": { "type": "string", "minLength": 1, "maxLength": 700 },
        "host": { "$ref": "#/definitions/kissHost" }
      }
    }
  }
}