{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://springfield-ham-radio.com/schemas/aprs-receive-v1.json",
  "title": "APRS receive block",
  "description": "Shape HamBench reads from an installed module when capabilities.aprsReceive is true. Matches parseAprsHostProfile and aprsReceiveProfile in ham-radio-ui at 9b24bc65de51ddd411166045ffda43550e020076. This file is the module contract check. radio-config-v1 does not define aprs; the protocol schema leaves the key through as an additional property.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "baudRate", "baudRates", "help", "monitorNote", "host"],
  "properties": {
    "mode": { "const": "monitor" },
    "baudRate": { "enum": [9600, 19200, 38400, 57600] },
    "baudRates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": [9600, 19200, 38400, 57600] }
    },
    "help": { "type": "string", "minLength": 1, "maxLength": 700 },
    "monitorNote": { "type": "string", "minLength": 1, "maxLength": 700 },
    "host": { "$ref": "#/definitions/host" }
  },
  "definitions": {
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interrupt", "prompt", "errorReply", "waitMs", "enter", "flows", "defaultFlow", "flowHelp", "setup", "recovery"],
      "properties": {
        "interrupt": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 16, "pattern": "^[\\u0020-\\u007e]+$" },
        "errorReply": { "type": "string", "minLength": 1, "maxLength": 16, "pattern": "^[\\u0020-\\u007e]+$" },
        "waitMs": { "type": "integer", "minimum": 1000, "maximum": 60000 },
        "listenMs": {
          "description": "How long Connect listens, in milliseconds, before treating the TNC as silent. HamBench reads aprs.host.listenMs, default 3000, range 500 to 15000. Command text in this window starts the enter steps. Silence sends the interrupt once, then kissExit once if this block declares it.",
          "type": "integer",
          "minimum": 500,
          "maximum": 15000
        },
        "kissExit": {
          "description": "Optional bytes sent once when Connect is still silent after the interrupt. The TM-D710A value is the KISS specification return-from-KISS frame 0xC0 0xFF 0xC0. The Kenwood manuals have not verified that frame on this radio.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "enter": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "label"],
            "properties": {
              "text": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[\\u0009-\\u007e]+$" },
              "label": { "type": "string", "minLength": 1, "maxLength": 24, "pattern": "^[\\u0020-\\u007e]+$" }
            }
          }
        },
        "flows": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["software", "none", "hardware"] }
        },
        "defaultFlow": { "enum": ["software", "none", "hardware"] },
        "flowHelp": { "type": "string", "minLength": 1, "maxLength": 700 },
        "setup": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 700 }
        },
        "recovery": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 700 }
        }
      }
    }
  }
}
