      "label": "APRS",
      "icon": "i-lucide-map-pinned",
      "groups": [
        {
          "id": "identity",
          "label": "Identity",
          "description": "Menu 500 stores the callsign and SSID as separate text. The callsign is 6 bytes at 0x1200, NUL-padded. The SSID is the literal suffix, including the hyphen (for example -7), in 3 NUL-padded bytes at 0x1206. It is not a 0-15 index. A shorter callsign does not shift the SSID."
        }
      ]
    },
    {
      "id": "dstar",
      "label": "D-STAR",
      "icon": "i-lucide-satellite",
      "groups": [
        {
          "id": "identity",
          "label": "Identity",
          "description": "Menu 610 is an 8-character callsign at 0x2B1 and a 4-character memo at 0x2B9, both space-padded. The radio shows them as CALL/MEMO."
        }
      ]
    },
    {
      "id": "groups",
