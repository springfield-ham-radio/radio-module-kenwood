          "id": "lockout",
          "type": "bits",
          "width": 1,
          "value": {
            "kind": "boolean"
          },
          "ui": {
            "group": "channel",
            "label": "Scan skip",
            "widget": "switch",
            "description": "Skips this memory during scan. The channel stays in memory and can still be selected directly."
