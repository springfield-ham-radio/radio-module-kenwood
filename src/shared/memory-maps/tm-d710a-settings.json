{
  "version": "1.0.0",
  "description": "Kenwood TM-D710A clone image: 1000 × 16-byte memories, parallel skip/band flags, 8-character names",
  "structs": [
    {
      "id": "flags",
      "seek": "0x0e00",
      "count": 1000,
      "stride": 2,
      "emptyWhen": {
        "equals": 255
      },
      "clearEmpty": true,
      "fields": [
        {
          "id": "band",
          "type": "u8",
          "value": {
            "kind": "integer",
            "min": 0,
            "max": 9
          },
          "ui": {
            "group": "channel",
            "label": "Band code",
            "widget": "integer"
          }
        },
        {
          "id": "lockout",
          "type": "u8",
          "value": {
            "kind": "boolean"
          },
          "ui": {
            "group": "channel",
            "label": "Scan skip",
            "widget": "switch"
          }
        }
      ]
    },
    {
