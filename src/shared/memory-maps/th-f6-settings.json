        {
          "id": "apo",
          "type": "u8",
          "value": {
            "kind": "enum",
            "values": [
              "Off",
              "30min",
              "60min"
            ]
          },
          "ui": {
            "group": "save",
            "label": "Automatic Power Off",
            "widget": "select",
            "menu": {
              "number": 18,
              "code": "APO"
            },
            "description": "Turns the radio off after this long with no keypress or tuning. Off disables it."
          }
        },
        {
          "id": "bat",
          "type": "u8",
          "value": {
            "kind": "enum",
            "values": [
              "Lithium",
              "Alkaline"
            ]
