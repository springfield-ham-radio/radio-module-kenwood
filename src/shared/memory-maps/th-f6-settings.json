        {
          "id": "mode",
          "type": "u8",
          "value": {
            "kind": "enum",
            "values": [
              "FM",
              "WFM",
              "AM",
              "LSB",
              "USB",
              "CW"
            ]
          },
          "ui": {
            "group": "channel",
            "label": "Mode",
            "widget": "select",
            "description": "Modulation for this memory. FM and AM are the usual voice modes. WFM is broadcast FM. LSB, USB, and CW are for the bands that support them."
          }
        },
        {
          "id": "skip",
          "type": "u8",
          "value": {
            "kind": "boolean"
          }
        },
        {
          "id": "split",
          "type": "u8",
          "value": {
            "kind": "boolean"
          }
        },
        {
          "id": "_pad",
          "type": "u8",
          "reserved": true,
          "value": {
            "kind": "ascii",
            "length": 5
          }
        },
        {
          "id": "name",
          "type": "u8",
          "value": {
            "kind": "ascii",
            "length": 8,
            "pad": 0
          }
        }
      ]
    },
    {
      "id": "settings",
      "seek": 12800,
      "fields": [
        {
          "id": "apo",
          "type": "u8",
          "value": {
            "kind": "enum",
            "values": [
              "Off",
              "30min",
              "60min"
            ]
          },
          "ui": {
            "group": "save",
            "label": "Automatic Power Off",
            "widget": "select",
            "menu": {
              "number": 18,
              "code": "APO"
            },
            "description": "Turns the radio off after this long with no keypress or tuning. Off disables it."
          }
        },
        {
          "id": "bat",
          "type": "u8",
          "value": {
            "kind": "enum",
            "values": [
              "Lithium",
              "Alkaline"
            ]
          },
          "ui": {
            "group": "save",
            "label": "Battery Type",
            "widget": "select",
            "menu": {
              "number": 30,
              "code": "BAT"
            },
            "description": "Battery chemistry used for the remaining-charge indicator. Lithium and alkaline packs read differently."
          }
        },
        {
          "id": "sv",
          "type": "u8",
          "value": {
            "kind": "enum",
            "values": [
              "Off",
              "0.2s",
              "0.4s",
              "0.6s",
              "0.8s",
              "1.0s",
              "2s",
              "3s",
              "4s",
              "5s"
            ]
          },
          "ui": {
            "group": "save",
            "label": "Battery Save",
            "widget": "select",
            "menu": {
              "number": 17,
              "code": "SAVE"
            },
            "description": "How long the receiver sleeps between checks while you are listening. Off keeps it awake. Longer times save more battery and can miss the start of a short call."
          }
        },
        {
          "id": "bal",
          "type": "u8",
          "value": {
            "kind": "enum",
            "values": [
              "100%:0%",
              "75%:25%",
              "50%:50%",
              "25%:75%",
              "0%:100%"
            ]
          },
          "ui": {
            "group": "main",
            "label": "Balance",
            "widget": "select",
            "description": "Speaker volume split between the A and B bands. 100%:0% is all A. This is not a numbered menu item."
          }
        },
        {
          "id": "mnf",
          "type": "u8",
          "value": {
            "kind": "enum",
            "values": [
              "Name",
              "Frequency"
            ]
          },
          "ui": {
            "group": "main",
            "label": "Memory Display Mode",
            "widget": "select",
            "description": "What a memory channel shows: the stored name, or the frequency. This is not a numbered menu item."
          }
        },
        {
          "id": "scr",
          "type": "u8",
          "value": {
            "kind": "enum",
            "values": [
              "Time",
              "Carrier",
              "Seek"
            ]
          },
          "ui": {
            "group": "main",
            "label": "Scan Resume",
            "widget": "select",
            "menu": {
              "number": 1,
              "code": "SCR"
            },
            "description": "What scan does after it stops on a signal. Time resumes after a few seconds. Carrier resumes when the signal drops. Seek stops and stays."
          }
        },
        {
          "id": "att",
          "type": "u8",
          "value": {
            "kind": "boolean"
          },
          "ui": {
            "group": "main",
            "label": "Attenuator",
            "widget": "switch",
            "description": "Reduces front-end gain so a very strong nearby signal does not overload the receiver. This is not a numbered menu item."
          }
        },
        {
          "id": "aro",
          "type": "u8",
          "value": {
            "kind": "boolean"
          },
          "ui": {
            "group": "main",
            "label": "Automatic Repeater Offset",
            "widget": "switch",
            "menu": {
              "number": 5,
              "code": "ARO"
            },
            "description": "Applies the standard repeater offset automatically when you tune into a repeater sub-band."
          }
        },
        {
          "id": "vox",
          "type": "u8",
          "value": {
            "kind": "boolean"
          },
          "ui": {
            "group": "aux",
            "label": "VOX Enable",
            "widget": "switch",
            "description": "Transmits when the radio hears your voice. On the keypad, VOX on busy is menu 20, gain is menu 21, and delay is menu 22."
          }
        },
        {
          "id": "cnt",
          "type": "u8",
          "value": {
            "kind": "integer",
            "min": 1,
            "max": 16
          },
          "ui": {
            "group": "display",
            "label": "Contrast",
            "widget": "integer",
            "menu": {
              "number": 16,
              "code": "CNT"
            },
            "description": "Display contrast. Higher numbers make the characters darker."
          }
        },
        {
          "id": "mes",
          "type": "u8",
          "value": {
            "kind": "ascii",
            "length": 8,
            "pad": 0
          },
          "ui": {
            "group": "display",
            "label": "Power-on Message",
            "widget": "text",
            "menu": {
              "number": 15,
              "code": "MES"
            },
            "description": "Text shown when the radio is turned on."
          }
        }
      ]
    }
  ],
  "channelBindings": {
    "records": "channels",
    "nameField": "name",
    "receiveFrequency": "freq",
    "transmitFrequency": "offset",
    "receiveTone": "ctone",
    "transmitTone": "rtone"
  }
}
