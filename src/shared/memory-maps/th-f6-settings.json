          "ui": {
            "group": "save",
            "label": "Battery Type",
            "widget": "select",
            "menu": {
              "number": 30,
              "code": "BAT"
            },
            "description": "Battery chemistry used for the remaining-charge indicator. Lithium and alkaline packs read differently."
          }
        },
        {
          "id": "sv",
          "type": "u8",
          "value": {
            "kind": "enum",
            "values": [
              "Off",
              "0.2s",
              "0.4s",
              "0.6s",
              "0.8s",
              "1.0s",
              "2s",
              "3s",
              "4s",
              "5s"
            ]
          },
          "ui": {
            "group": "save",
            "label": "Battery Save",
            "widget": "select",
            "menu": {
              "number": 17,
              "code": "SV"
            },
            "description": "How long the receiver sleeps between checks while you are listening. Off keeps it awake. Longer times save more battery and can miss the start of a short call."
          }
        },
        {
          "id": "bal",
          "type": "u8",
          "value": {
            "kind": "enum",
            "values": [
              "100%:0%",
              "75%:25%",
              "50%:50%",
              "25%:75%",
              "0%:100%"
            ]
          },
          "ui": {
            "group": "main",
            "label": "Balance",
            "widget": "select",
            "description": "Speaker volume split between the A and B bands. 100%:0% is all A. This is not a numbered menu item."
          }
        },
        {
          "id": "mnf",
          "type": "u8",
          "value": {
            "kind": "enum",
            "values": [
              "Name",
              "Frequency"
            ]
          },
          "ui": {
            "group": "main",
            "label": "Memory Display Mode",
            "widget": "select",
            "description": "What a memory channel shows: the stored name, or the frequency. This is not a numbered menu item."
          }
        },
        {
          "id": "scr",
          "type": "u8",
          "value": {
            "kind": "enum",
            "values": [
              "Time",
              "Carrier",
              "Seek"
            ]
          },
          "ui": {
            "group": "main",
            "label": "Scan Resume",
            "widget": "select",
            "menu": {
              "number": 1,
              "code": "SCR"
            },
            "description": "What scan does after it stops on a signal. Time resumes after a few seconds. Carrier resumes when the signal drops. Seek stops and stays."
          }
        },
        {
          "id": "att",
          "type": "u8",
          "value": {
            "kind": "boolean"
          },
          "ui": {
            "group": "main",
            "label": "Attenuator",
            "widget": "switch",
            "description": "Reduces front-end gain so a very strong nearby signal does not overload the receiver. This is not a numbered menu item."
          }
        },
        {
          "id": "aro",
          "type": "u8",
          "value": {
            "kind": "boolean"
          },
          "ui": {
            "group": "main",
            "label": "Automatic Repeater Offset",
            "widget": "switch",
            "menu": {
              "number": 5,
              "code": "ARO"
            },
            "description": "Applies the standard repeater offset automatically when you tune into a repeater sub-band."
          }
