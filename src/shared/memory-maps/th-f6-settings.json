{
  "version": "1.0.0",
  "description": "Kenwood TH-F6 logical channel image (32-byte records). Radio I/O is live CAT, not this image.",
  "groups": [
    {
      "id": "display",
      "label": "Display",
      "icon": "i-lucide-monitor"
    },
    {
      "id": "aux",
      "label": "Auxiliary",
      "icon": "i-lucide-unplug"
    },
    {
      "id": "save",
      "label": "Power Save",
      "icon": "i-lucide-battery-medium"
    },
    {
      "id": "main",
      "label": "Main",
      "icon": "i-lucide-layout-dashboard"
    }
  ],
  "structs": [
    {
      "id": "channels",
      "seek": 0,
      "count": 400,
      "stride": 32,
      "emptyWhen": {
        "equals": 255
      },
      "clearEmpty": true,
      "fields": [
        {
          "id": "freq",
          "type": "u32",
          "value": {
            "kind": "integer"
          }
        },
        {
          "id": "offset",
          "type": "u32",
          "value": {
            "kind": "integer"
          }
        },
        {
          "id": "tuning_step",
          "type": "u8",
          "value": {
            "kind": "enum",
            "values": [
              "5",
              "6.25",
              "8.33",
              "9",
              "10",
              "12.5",
              "15",
              "20",
              "25",
              "30",
              "50",
              "100"
            ]
          },
          "ui": {
            "group": "channel",
            "label": "Tuning step (kHz)",
            "widget": "select",
            "description": "How far the frequency moves for each click of the tuning control, in kHz."
          }
        },
        {
          "id": "duplex",
          "type": "u8",
          "value": {
            "kind": "enum",
            "values": [
              "",
              "+",
              "-",
              "split"
            ]
          },
          "ui": {
            "group": "channel",
            "label": "Duplex",
            "widget": "select",
            "description": "Repeater shift for this memory. Blank transmits on the receive frequency. + transmits above it, − transmits below it, and split uses a separate transmit frequency."
          }
        },
        {
          "id": "tone_mode",
          "type": "u8",
          "value": {
            "kind": "boolean"
          }
        },
        {
          "id": "ctcss_mode",
